{
	email {$ACME_EMAIL}
	admin off
	# Gerçek istemci IP'si: site Cloudflare (turuncu bulut) arkasında yayınlanıyor. Caddy'ye
	# bağlanan adres bir Cloudflare kenar sunucusu (veya sunucudaki Nginx gibi özel ağdaki
	# bir proxy) ise istemci IP'si CF-Connecting-IP / X-Forwarded-For'dan alınır. Aksi halde
	# tüm kullanıcılar aynı Cloudflare IP'sini paylaşır ve API'nin IP başına istek sınırı
	# herkes için ortak dolar (429 "Çok fazla istek"). Doğrudan (Cloudflare dışından) gelen
	# isteklerde bu başlıklar YOK SAYILIR - sahte IP ile sınır aşılamaz.
	# Cloudflare aralıkları: https://www.cloudflare.com/ips/ (değişirse güncelleyin)
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(api_upstream) {
	reverse_proxy api:8000 {
		# API (uvicorn --proxy-headers, FORWARDED_ALLOW_IPS=Caddy) yalnızca bu değeri okur.
		header_up X-Forwarded-For {client_ip}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	request_body {
		max_size 32MB
	}
	@api path /api/* /health /health/ready
	handle @api {
		import api_upstream
	}
	handle /uploads/* {
		import api_upstream
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

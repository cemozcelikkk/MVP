PROJECT_NAME=KaravanTR API
API_V1_STR=/api/v1
ENVIRONMENT=development

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Alembic de aynı (async) DSN'i kullanır, ayrı bir sync sürücüye gerek yok.
DATABASE_URL=postgresql+asyncpg://karavantr:karavantr@localhost:5432/karavantr_db

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# bbox/sync sorgularında tek seferde dönebilecek azami/varsayılan kayıt sayısı
SPOTS_BBOX_MAX_LIMIT=500
SPOTS_BBOX_DEFAULT_LIMIT=200

# --- Medya / Depolama ---
# "local" (backend/uploads/) veya "s3" (AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# STORAGE_BACKEND=s3 değilse aşağıdakiler gerekmez.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=karavantr-photos
# S3_REGION_NAME=auto
# S3_PUBLIC_CUSTOM_DOMAIN=cdn.karavantr.com

# Tarayıcıdan API'ye istek atmasına izin verilen origin'ler (JSON dizisi).
# Belirtilmezse config.py'deki yerel geliştirme varsayılanları (Vite 5173/5174,
# 127.0.0.1 karşılıkları, vite preview 4173, 3000) kullanılır. Üretimde gerçek
# alan adınızı yazın; "*" kullanmayın.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Account email delivery. File outbox is allowed only in development.
FRONTEND_URL=http://localhost:5173
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=.mail-outbox
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_STARTTLS=true

# Database-backed request quotas are shared between API workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=180
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10

# Replace public demo providers with your own endpoints for production traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=KaravanTR/0.1 (contact: replace-with-your-email)
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
